#!/usr/bin/env python

import rospy
import tf2_ros
from geometry_msgs.msg import TransformStamped
from nav_msgs.msg import Odometry

class T265TFRelayNode:
    def __init__(self):
        rospy.init_node('t265_tf_relay_node')
        self.pub_tf = tf2_ros.TransformBroadcaster()
        self.odom_topic = rospy.get_param('~odom_topic', '/camera/odom/sample')
        self.frame_id = rospy.get_param('~pose_frame_id', 't265_pose_frame')
        self.child_frame_id = rospy.get_param('~odom_frame_id', 't265_odom_frame')
        self.sub = rospy.Subscriber(self.odom_topic, Odometry, self.odom_callback)
        rospy.loginfo("t265_tf_relay_node initialized: Publishing TF from %s to %s using %s",
                      self.frame_id, self.child_frame_id, self.odom_topic)

    def odom_callback(self, msg):
        t = TransformStamped()
        t.header = msg.header
        t.header.stamp = msg.header.stamp
        t.header.frame_id = self.frame_id
        t.child_frame_id = self.child_frame_id
        t.transform.translation = msg.pose.pose.position
        t.transform.rotation = msg.pose.pose.orientation
        self.pub_tf.sendTransform(t)

if __name__ == '__main__':
    try:
        T265TFRelayNode()
        rospy.spin()
    except rospy.ROSInterruptException:
        pass
